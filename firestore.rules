rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function hasProfile() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function getUser(uid) { return get(/databases/$(database)/documents/users/$(uid)).data; }
    function me() { return getUser(request.auth.uid); }
    function isStaff() { return hasProfile() && me().role in ['teacher', 'admin']; }
    function isAdmin() { return hasProfile() && me().role == 'admin'; }
    function sameOrg(orgId) { return hasProfile() && me().orgId == orgId; }
    function validUi(v) { return v in ['education', 'operations', 'depot']; }
    function validTheme(v) { return v in ['light', 'dark', 'system']; }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || (isStaff() && sameOrg(getUser(uid).orgId)));
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == 'student'
        && request.resource.data.orgId == 'default-org'
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() >= 2 && request.resource.data.fullName.size() <= 120
        && request.resource.data.keys().hasOnly(['email', 'role', 'orgId', 'fullName', 'ui', 'themeMode', 'createdAt']);
      
      allow update: if signedIn() && (
        (request.auth.uid == uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fullName', 'position', 'department', 'ui', 'themeMode']))
        || (isAdmin() && sameOrg(resource.data.orgId) && request.auth.uid != uid)
      );
    }

    match /publicProfiles/{uid} {
      allow read: if signedIn() && sameOrg(getUser(uid).orgId);
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['displayName', 'avatar', 'orgId', 'updatedAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2 && request.resource.data.displayName.size() <= 120
        && (request.resource.data.avatar == null || (request.resource.data.avatar is string && request.resource.data.avatar.size() < 40000 && request.resource.data.avatar.matches('^data:image/(jpeg|png|webp);base64,.*')))
        && request.resource.data.orgId == getUser(request.auth.uid).orgId;
    }

    match /tests/{testId} {
      allow read: if signedIn() && sameOrg(resource.data.orgId) && (resource.data.status == 'published' || resource.data.authorId == request.auth.uid);
      // ... (остальные правила остаются без изменений)
    }
  }
}