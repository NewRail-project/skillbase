rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function userPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function hasProfile() { return signedIn() && exists(userPath()); }
    function me() { return get(userPath()).data; }
    function isAdmin() { return hasProfile() && me().role == 'admin'; }
    function isTeacher() { return hasProfile() && me().role == 'teacher'; }
    function isStaff() { return isAdmin() || isTeacher(); }
    function sameOrg(orgId) { return hasProfile() && me().orgId == orgId; }
    function validUi(v) { return v in ['education', 'operations', 'depot']; }

    // Пользователи: роль и организацию клиент менять не может, только админ
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'role', 'orgId', 'ui', 'createdAt'])
        && request.resource.data.role == 'student'
        && request.resource.data.orgId == 'default-org'
        && validUi(request.resource.data.ui);
      allow update: if signedIn() && (
        isAdmin() ||
        (request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ui'])
          && validUi(request.resource.data.ui)));
      allow delete: if false;
    }

    // Публичная часть теста (без правильных ответов)
    match /tests/{testId} {
      allow read: if signedIn() && (
        resource.data.authorId == request.auth.uid ||
        isAdmin() ||
        (resource.data.status == 'published' && sameOrg(resource.data.orgId)));
      allow create: if isStaff()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.orgId == me().orgId
        && request.resource.data.status in ['draft', 'published'];
      allow update: if signedIn()
        && (isAdmin() || (isTeacher() && resource.data.authorId == request.auth.uid))
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.orgId == resource.data.orgId
        && request.resource.data.status in ['draft', 'published'];
      allow delete: if isAdmin() || (isTeacher() && resource.data.authorId == request.auth.uid);
    }

    // Ключи (правильные ответы): студентам доступа НЕТ
    match /testKeys/{testId} {
      allow read: if isAdmin() || (isTeacher() && (resource.data.authorId == request.auth.uid || sameOrg(resource.data.orgId)));
      allow create: if isStaff()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.orgId == me().orgId;
      allow update: if isAdmin() || (isTeacher() && resource.data.authorId == request.auth.uid);
      allow delete: if isAdmin() || (isTeacher() && resource.data.authorId == request.auth.uid);
    }

    // Попытки: студент создаёт свою (без оценки), оценивает преподаватель
    match /attempts/{attemptId} {
      allow read: if signedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin() ||
        (isTeacher() && sameOrg(resource.data.orgId)));
      allow create: if hasProfile()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.orgId == me().orgId
        && request.resource.data.status == 'submitted'
        && request.resource.data.keys().hasOnly(['userId', 'userEmail', 'orgId', 'testId', 'testTitle', 'answers', 'startedAt', 'submittedAt', 'status']);
      allow update: if (isAdmin() || (isTeacher() && sameOrg(resource.data.orgId)))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'score', 'total', 'gradedAt', 'gradedBy']);
      allow delete: if false;
    }
  }
}
