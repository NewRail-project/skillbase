rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function hasProfile() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function isStaff() { return hasProfile() && profile().role in ['teacher', 'admin']; }
    function isAdmin() { return hasProfile() && profile().role == 'admin'; }
    function sameOrg(orgId) { return hasProfile() && profile().orgId == orgId; }
    function validUi(v) { return v in ['education', 'operations', 'depot']; }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || (isStaff() && sameOrg(resource.data.orgId)));
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == 'student'
        && request.resource.data.orgId == 'default-org'
        && validUi(request.resource.data.ui);
      allow update: if signedIn()
        && validUi(request.resource.data.ui)
        && request.resource.data.orgId == resource.data.orgId
        && ((request.auth.uid == uid && request.resource.data.role == resource.data.role)
            || (isAdmin() && sameOrg(resource.data.orgId)));
      allow delete: if false;
    }

    match /tests/{testId} {
      allow read: if hasProfile() && sameOrg(resource.data.orgId)
        && (resource.data.status == 'published' || resource.data.authorId == request.auth.uid);
      allow create: if isStaff()
        && request.resource.data.authorId == request.auth.uid
        && sameOrg(request.resource.data.orgId);
      allow update: if isStaff()
        && resource.data.authorId == request.auth.uid
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.orgId == resource.data.orgId;
      allow delete: if isStaff() && resource.data.authorId == request.auth.uid;

      match /versions/{versionId} {
        allow read: if hasProfile()
          && sameOrg(get(/databases/$(database)/documents/tests/$(testId)).data.orgId);
        allow create: if isStaff()
          && get(/databases/$(database)/documents/tests/$(testId)).data.authorId == request.auth.uid;
      }
    }

    match /testKeys/{testId} {
      allow read: if isStaff() && resource.data.authorId == request.auth.uid;
      allow create: if isStaff()
        && request.resource.data.authorId == request.auth.uid
        && sameOrg(request.resource.data.orgId);
      allow update: if isStaff()
        && resource.data.authorId == request.auth.uid
        && request.resource.data.authorId == resource.data.authorId;
      allow delete: if isStaff() && resource.data.authorId == request.auth.uid;
    }
  }
}
