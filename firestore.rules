rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function hasProfile() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function isAdmin() { return hasProfile() && profile().role == 'admin'; }
    function isTeacher() { return hasProfile() && profile().role == 'teacher'; }
    function sameOrg(orgId) { return hasProfile() && profile().orgId == orgId; }
    function validUi(v) { return v in ['education', 'operations', 'depot']; }
    function isAuthorizedToReadTests() {
      return hasProfile() && 
        (sameOrg(resource.data.orgId) || 
         (isAdmin() && resource.data.orgId == 'default-org'));
    }
    function isAuthorizedToWriteTests() {
      return isAdmin() || isTeacher();
    }
    function isAuthorizedToAssignTests() {
      return isAdmin() || isTeacher();
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.role == 'student' && request.resource.data.orgId == 'default-org' && validUi(request.resource.data.ui);
      allow update: if signedIn() && 
        (request.auth.uid == uid || isAdmin() || (isTeacher() && sameOrg(resource.data.orgId)));
      allow delete: if false;
    }

    match /tests/{testId} {
      allow read: if isAuthorizedToReadTests() && resource.data.status == 'published';
      allow create: if isAuthorizedToWriteTests() && request.resource.data.authorId == request.auth.uid;
      allow update: if isAuthorizedToWriteTests() && resource.data.authorId == request.auth.uid;
      allow delete: if isAdmin() && resource.data.authorId == request.auth.uid;

      match /versions/{versionId} {
        allow read: if isAuthorizedToReadTests();
        allow create: if isAuthorizedToWriteTests() && get(/databases/$(database)/documents/tests/$(testId)).data.authorId == request.auth.uid;
      }
    }

    match /testKeys/{testId} {
      allow read: if isAdmin() || (isTeacher() && sameOrg(get(/databases/$(database)/documents/tests/$(testId)).data.orgId));
      allow create: if isAdmin() || isTeacher() && request.resource.data.authorId == request.auth.uid;
      allow update: if isAdmin() || isTeacher() && resource.data.authorId == request.auth.uid;
      allow delete: if isAdmin() && resource.data.authorId == request.auth.uid;
    }

    match /assignments/{assignmentId} {
      allow read: if signedIn() && 
        (isAdmin() || 
         (isTeacher() && sameOrg(get(/databases/$(database)/documents/assignments/$(assignmentId)).data.groupId)));
      allow create: if isAdmin() || isTeacher();
      allow update: if isAdmin() || isTeacher() && resource.data.createdBy == request.auth.uid;
      allow delete: if isAdmin() && resource.data.createdBy == request.auth.uid;
    }

    match /attempts/{attemptId} {
      allow read: if signedIn() && 
        (isAdmin() || 
         (isTeacher() && sameOrg(get(/databases/$(database)/documents/attempts/$(attemptId)).data.testId)));
      allow create: if signedIn() && request.auth.uid == get(/databases/$(database)/documents/attempts/$(attemptId)).data.userId;
      allow update: if isAdmin();
    }

    match /tests/{testId}/attempts/{attemptId} {
      allow read: if signedIn() && 
        (isAdmin() || 
         (isTeacher() && sameOrg(get(/databases/$(database)/documents/tests/$(testId)).data.orgId)));
      allow write: if signedIn() && 
        (isAdmin() || 
         (isTeacher() && get(/databases/$(database)/documents/tests/$(testId)).data.orgId == request.resource.data.testId));
    }
  }
}