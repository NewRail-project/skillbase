rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function hasProfile() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isStaff() { return hasProfile() && me().role in ['teacher', 'admin']; }
    function isAdmin() { return hasProfile() && me().role == 'admin'; }
    function sameOrg(orgId) { return hasProfile() && me().orgId == orgId; }
    function validUi(v) { return v in ['education', 'operations', 'depot']; }

    // Профиль: при регистрации всегда студент в default-org.
    // Сам пользователь может менять только тему. Роли выдаёт администратор.
    match /users/{uid} {
      allow read: if signedIn()
        && (request.auth.uid == uid || (isStaff() && sameOrg(resource.data.orgId)));
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == 'student'
        && request.resource.data.orgId == 'default-org'
        && validUi(request.resource.data.ui);
      allow update: if signedIn() && validUi(request.resource.data.ui)
        && (
          (request.auth.uid == uid
            && request.resource.data.role == resource.data.role
            && request.resource.data.orgId == resource.data.orgId)
          || (isAdmin() && sameOrg(resource.data.orgId))
        );
      allow delete: if false;
    }

    // Тесты: публичная часть без ответов. Черновик видит только автор.
    match /tests/{testId} {
      allow read: if hasProfile() && sameOrg(resource.data.orgId)
        && (resource.data.status == 'published' || resource.data.authorId == request.auth.uid);
      allow create: if isStaff()
        && request.resource.data.authorId == request.auth.uid
        && sameOrg(request.resource.data.orgId);
      allow update: if isStaff()
        && resource.data.authorId == request.auth.uid
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.orgId == resource.data.orgId;
      allow delete: if isStaff() && resource.data.authorId == request.auth.uid;

      match /versions/{versionId} {
        allow read: if hasProfile()
          && sameOrg(get(/databases/$(database)/documents/tests/$(testId)).data.orgId);
        allow create: if isStaff()
          && get(/databases/$(database)/documents/tests/$(testId)).data.authorId == request.auth.uid;
      }
    }

    // Ключи ответов: только автор-преподаватель.
    match /testKeys/{testId} {
      allow read, delete: if isStaff() && resource.data.authorId == request.auth.uid;
      allow create: if isStaff()
        && request.resource.data.authorId == request.auth.uid
        && sameOrg(request.resource.data.orgId);
      allow update: if isStaff()
        && resource.data.authorId == request.auth.uid
        && request.resource.data.authorId == resource.data.authorId;
    }

    // assignments и attempts закрыты до этапа 3 (всё, что не описано, запрещено).
  }
}
