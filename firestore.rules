rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Общие функции ----------
    function signedIn() { return request.auth != null; }
    function hasProfile() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function getUser(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }
    function me() { return getUser(request.auth.uid); }
    function myOrg() { return me().orgId; }
    function isStaff() {
      return hasProfile() && me().role in ['teacher', 'admin'];
    }
    function isAdmin() {
      return hasProfile() && me().role == 'admin';
    }
    function validUi(v) { return v in ['education', 'operations', 'depot']; }
    function validTheme(v) { return v in ['light', 'dark', 'system']; }
    function validTitle(v) {
      return v is string && v.size() > 0 && v.size() <= 120;
    }
    // ФИО и публичное имя не могут состоять из одних пробелов.
    function validFullName(v) {
      return validTitle(v) && v.matches('.*\\S.*');
    }
    function validGroupId(v) {
      return v is string && v.size() > 0 && v.size() <= 100;
    }
    function optionalGroupIdOk(data) {
      return !data.keys().hasAny(['groupId'])
        || data.groupId == null
        || validGroupId(data.groupId);
    }
    function testData(testId) {
      return get(/databases/$(database)/documents/tests/$(testId)).data;
    }
    function testExists(testId) {
      return exists(/databases/$(database)/documents/tests/$(testId));
    }
    // Проверка назначения по уже прочитанному документу: так get() вызывается
    // один раз, а не на каждое поле (у Firestore есть лимит обращений).
    function assignmentMatches(data, testId, orgId, groupId, deadlineAt) {
      return data.status == 'active'
        && data.orgId == orgId
        && data.testId == testId
        && data.groupId == groupId
        && (
          !data.keys().hasAny(['deadline'])
          || data.deadline == null
          || data.deadline > request.time
        )
        && (
          !data.keys().hasAny(['deadline'])
          || deadlineAt == data.deadline
        );
    }

    // ---------- Пользователи ----------
    match /users/{uid} {
      // Свой профиль или сотрудник той же организации.
      allow read: if signedIn() && (
        request.auth.uid == uid
        || (isStaff() && resource.data.orgId == myOrg())
      );

      // Самостоятельная регистрация: только студент в default-org и
      // default-group. Значения должны совпадать с configs/organization.js.
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'email', 'role', 'orgId', 'groupId', 'fullName', 'position',
          'department', 'ui', 'themeMode', 'createdAt'
        ])
        && request.resource.data.email is string
        && request.resource.data.role == 'student'
        && request.resource.data.orgId == 'default-org'
        && request.resource.data.groupId == 'default-group'
        && validFullName(request.resource.data.fullName)
        && validUi(request.resource.data.ui)
        && (!request.resource.data.keys().hasAny(['position'])
          || (request.resource.data.position is string
            && request.resource.data.position.size() <= 120))
        && (!request.resource.data.keys().hasAny(['department'])
          || (request.resource.data.department is string
            && request.resource.data.department.size() <= 120))
        && (!request.resource.data.keys().hasAny(['themeMode'])
          || validTheme(request.resource.data.themeMode))
        && request.resource.data.createdAt is timestamp;

      // Пользователь меняет только личные поля. Роль, организация и группа
      // назначаются администратором. Администратор не может менять себя.
      allow update: if signedIn() && (
        (
          request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'fullName', 'position', 'department', 'ui', 'themeMode'
          ])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['fullName'])
            || validFullName(request.resource.data.fullName))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['ui'])
            || validUi(request.resource.data.ui))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['themeMode'])
            || validTheme(request.resource.data.themeMode))
        )
        || (
          isAdmin()
          && request.auth.uid != uid
          && resource.data.orgId == myOrg()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'role', 'groupId', 'fullName', 'position', 'department',
            'ui', 'themeMode', 'updatedAt'
          ])
          && request.resource.data.role in ['student', 'teacher', 'admin']
          && optionalGroupIdOk(request.resource.data)
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['fullName'])
            || validFullName(request.resource.data.fullName))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['ui'])
            || validUi(request.resource.data.ui))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['themeMode'])
            || validTheme(request.resource.data.themeMode))
          && (!request.resource.data.keys().hasAny(['updatedAt'])
            || request.resource.data.updatedAt is timestamp)
        )
      );

      allow delete: if isAdmin()
        && request.auth.uid != uid
        && resource.data.orgId == myOrg();
    }

    // ---------- Публичные профили ----------
    match /publicProfiles/{uid} {
      allow read: if signedIn() && resource.data.orgId == myOrg();

      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'displayName', 'avatar', 'orgId', 'updatedAt'
        ])
        && validFullName(request.resource.data.displayName)
        && (!request.resource.data.keys().hasAny(['avatar'])
          || request.resource.data.avatar == null
          || (request.resource.data.avatar is string
            && request.resource.data.avatar.size() < 40000
            && request.resource.data.avatar.matches('^data:image/(jpeg|png|webp);base64,.*')))
        && request.resource.data.orgId == myOrg()
        && request.resource.data.updatedAt is timestamp;

      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'displayName', 'avatar', 'orgId', 'updatedAt'
        ])
        && validFullName(request.resource.data.displayName)
        && (!request.resource.data.keys().hasAny(['avatar'])
          || request.resource.data.avatar == null
          || (request.resource.data.avatar is string
            && request.resource.data.avatar.size() < 40000
            && request.resource.data.avatar.matches('^data:image/(jpeg|png|webp);base64,.*')))
        && request.resource.data.orgId == myOrg()
        && request.resource.data.orgId == resource.data.orgId
        && request.resource.data.updatedAt is timestamp;

      allow delete: if false;
    }

    // ---------- Тесты ----------
    match /tests/{testId} {
      // Автор видит свои черновики; сотрудники организации — опубликованные.
      allow read: if signedIn() && (
        resource.data.authorId == request.auth.uid
        || (resource.data.status == 'published' && resource.data.orgId == myOrg())
        // Администратор организации может открыть и черновик другого автора.
        || (isAdmin() && resource.data.orgId == myOrg())
      );

      allow create: if isStaff()
        && request.resource.data.id == testId
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.orgId == myOrg()
        && request.resource.data.status == 'draft'
        && validTitle(request.resource.data.title)
        && request.resource.data.description is string
        && request.resource.data.instructions is string
        && request.resource.data.category is string
        && request.resource.data.color is string
        && request.resource.data.mode is string
        && request.resource.data.settings is map
        && request.resource.data.questions is list
        && request.resource.data.questions.size() > 0
        && request.resource.data.questions.size() <= 2000
        && request.resource.data.version is int
        && request.resource.data.version >= 1
        && request.resource.data.publishedAt == null
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.keys().hasOnly([
          'id', 'title', 'description', 'instructions', 'category', 'color',
          'authorId', 'orgId', 'status', 'mode', 'settings', 'version',
          'questions', 'createdAt', 'updatedAt', 'publishedAt'
        ]);

      allow update: if isStaff()
        && resource.data.orgId == myOrg()
        && (resource.data.authorId == request.auth.uid || isAdmin())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title', 'description', 'instructions', 'category', 'color',
          'status', 'mode', 'settings', 'version', 'questions',
          'updatedAt', 'publishedAt'
        ])
        && request.resource.data.id == resource.data.id
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.orgId == resource.data.orgId
        && request.resource.data.status in ['draft', 'published']
        && validTitle(request.resource.data.title)
        && request.resource.data.description is string
        && request.resource.data.instructions is string
        && request.resource.data.category is string
        && request.resource.data.color is string
        && request.resource.data.mode is string
        && request.resource.data.settings is map
        && request.resource.data.questions is list
        && request.resource.data.questions.size() > 0
        && request.resource.data.questions.size() <= 2000
        && (request.resource.data.status == 'draft'
          || request.resource.data.questions.size() <= 200)
        && request.resource.data.version is int
        && request.resource.data.version >= 1
        && (!request.resource.data.keys().hasAny(['publishedAt'])
          || request.resource.data.publishedAt == null
          || request.resource.data.publishedAt is timestamp)
        && request.resource.data.updatedAt is timestamp;

      allow delete: if isStaff()
        && resource.data.orgId == myOrg()
        && (resource.data.authorId == request.auth.uid || isAdmin());

      // Версии опубликованного теста.
      match /versions/{versionId} {
        allow read: if isStaff() && resource.data.orgId == myOrg();

        allow create: if isStaff()
          && testExists(testId)
          && testData(testId).orgId == myOrg()
          && (testData(testId).authorId == request.auth.uid || isAdmin())
          && request.resource.data.id == testId
          && request.resource.data.authorId == testData(testId).authorId
          && request.resource.data.orgId == myOrg()
          && request.resource.data.status == 'published'
          && request.resource.data.version is int
          && request.resource.data.version >= 1
          && request.resource.data.questions is list
          && request.resource.data.questions.size() > 0
          && request.resource.data.questions.size() <= 200
          && request.resource.data.createdAt is timestamp
          && request.resource.data.keys().hasOnly([
            'id', 'title', 'description', 'instructions', 'category', 'color',
            'authorId', 'orgId', 'status', 'mode', 'settings', 'version',
            'questions', 'createdAt', 'updatedAt', 'publishedAt'
          ]);

        // Опубликованная версия неизменяема.
        allow update, delete: if false;
      }
    }

    // ---------- Ключи ответов ----------
    match /testKeys/{testId} {
      // Ученик не должен видеть правильные ответы никогда.
      allow read: if isStaff() && resource.data.orgId == myOrg();

      allow create: if isStaff()
        && testExists(testId)
        && testData(testId).orgId == myOrg()
        && (testData(testId).authorId == request.auth.uid || isAdmin())
        && request.resource.data.authorId == testData(testId).authorId
        && request.resource.data.orgId == myOrg()
        && request.resource.data.items is map
        && request.resource.data.items.keys().size() <= 2000
        && request.resource.data.version is int
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.keys().hasOnly([
          'authorId', 'orgId', 'items', 'version', 'updatedAt'
        ]);

      allow update: if isStaff()
        && resource.data.orgId == myOrg()
        && (resource.data.authorId == request.auth.uid || isAdmin())
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.orgId == resource.data.orgId
        && request.resource.data.items is map
        && request.resource.data.items.keys().size() <= 2000
        && request.resource.data.version is int
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.keys().hasOnly([
          'authorId', 'orgId', 'items', 'version', 'updatedAt'
        ]);

      allow delete: if isStaff()
        && resource.data.orgId == myOrg()
        && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    // ---------- Попытки ----------
    match /attempts/{attemptId} {
      // Свои попытки или все попытки организации для сотрудника.
      allow read: if signedIn() && (
        resource.data.userId == request.auth.uid
        || (isStaff() && resource.data.orgId == myOrg())
      );

      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.orgId == myOrg()
        && request.resource.data.userEmail is string
        && request.resource.data.testId is string
        && request.resource.data.testTitle is string
        && request.resource.data.assignmentId is string
        && request.resource.data.status == 'in_progress'
        && request.resource.data.answers is map
        && request.resource.data.attemptNo is int
        && request.resource.data.attemptNo >= 1
        && request.resource.data.attemptNo <= 100
        && request.resource.data.startedAt is timestamp
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && (request.resource.data.deadlineAt == null
          || request.resource.data.deadlineAt is timestamp)
        && testExists(request.resource.data.testId)
        && testData(request.resource.data.testId).status == 'published'
        && testData(request.resource.data.testId).orgId == myOrg()
        // Снимок ФИО и группы должен совпадать с профилем на момент старта.
        // Поля необязательные: старые профили могли быть без ФИО/группы.
        && (!request.resource.data.keys().hasAny(['userName'])
          || (request.resource.data.userName is string
            && request.resource.data.userName.size() > 0
            && request.resource.data.userName.size() <= 120
            && request.resource.data.userName == me().fullName))
        && (!request.resource.data.keys().hasAny(['groupId'])
          || validGroupId(request.resource.data.groupId))
        // Если указано задание, оно должно быть активным, относиться к тому
        // же тесту и группе, а срок попытки — совпадать со сроком задания.
        && (
          request.resource.data.assignmentId == ''
          || assignmentMatches(
            get(/databases/$(database)/documents/assignments/$(request.resource.data.assignmentId)).data,
            request.resource.data.testId,
            request.resource.data.orgId,
            me().groupId,
            request.resource.data.deadlineAt
          )
        )
        && request.resource.data.keys().hasOnly([
          'userId', 'userEmail', 'userName', 'groupId', 'orgId', 'testId',
          'testTitle', 'assignmentId', 'answers', 'startedAt', 'status',
          'attemptNo', 'deadlineAt', 'createdAt', 'updatedAt'
        ]);

      // Ученик может менять ответы только в незавершённой попытке и только
      // перевести её в submitted. Оценку он выставить не может.
      allow update: if signedIn() && (
        (
          resource.data.userId == request.auth.uid
          && resource.data.status == 'in_progress'
          && (
            (
              request.resource.data.status == 'in_progress'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'answers', 'updatedAt'
              ])
              && request.resource.data.answers is map
              && request.resource.data.updatedAt is timestamp
            )
            || (
              request.resource.data.status == 'submitted'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'answers', 'status', 'submittedAt', 'finishedAt', 'updatedAt'
              ])
              && request.resource.data.answers is map
              && request.resource.data.submittedAt is timestamp
              && request.resource.data.finishedAt is timestamp
              && request.resource.data.updatedAt is timestamp
            )
          )
        )
        || (
          isStaff()
          && resource.data.orgId == myOrg()
          && resource.data.status in ['submitted', 'graded']
          && request.resource.data.status == 'graded'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'score', 'total', 'percent', 'review',
            'gradedBy', 'gradedAt', 'finishedAt', 'updatedAt'
          ])
          && request.resource.data.score is number
          && request.resource.data.score >= 0
          && request.resource.data.total is number
          && request.resource.data.total >= 0
          && request.resource.data.score <= request.resource.data.total
          && request.resource.data.percent is int
          && request.resource.data.percent >= 0
          && request.resource.data.percent <= 100
          && request.resource.data.review is map
          && request.resource.data.gradedBy == request.auth.uid
          && request.resource.data.gradedAt is timestamp
          && request.resource.data.finishedAt is timestamp
          && request.resource.data.updatedAt is timestamp
        )
      );

      allow delete: if false;
    }

    // ---------- Назначения ----------
    match /assignments/{assignmentId} {
      // Сотрудник организации или студент назначенной ему группы.
      allow read: if signedIn() && (
        (isStaff() && resource.data.orgId == myOrg())
        || (
          resource.data.status == 'active'
          && resource.data.orgId == myOrg()
          && resource.data.groupId == me().groupId
        )
      );

      allow create: if isStaff()
        && request.resource.data.teacherId == request.auth.uid
        && request.resource.data.orgId == myOrg()
        && request.resource.data.status == 'active'
        && validGroupId(request.resource.data.groupId)
        && request.resource.data.testId is string
        && request.resource.data.testTitle is string
        && testExists(request.resource.data.testId)
        && testData(request.resource.data.testId).status == 'published'
        && testData(request.resource.data.testId).orgId == myOrg()
        && (request.resource.data.deadline == null
          || request.resource.data.deadline is timestamp)
        && (request.resource.data.attemptsLimit == null
          || (request.resource.data.attemptsLimit is int
            && request.resource.data.attemptsLimit >= 1
            && request.resource.data.attemptsLimit <= 50))
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.keys().hasOnly([
          'testId', 'testTitle', 'teacherId', 'groupId', 'orgId',
          'deadline', 'attemptsLimit', 'status', 'createdAt', 'updatedAt'
        ]);

      allow update: if isStaff()
        && resource.data.orgId == myOrg()
        && (resource.data.teacherId == request.auth.uid || isAdmin())
        && request.resource.data.testId == resource.data.testId
        && request.resource.data.teacherId == resource.data.teacherId
        && request.resource.data.groupId == resource.data.groupId
        && request.resource.data.orgId == resource.data.orgId
        && request.resource.data.status in ['active', 'closed']
        && (!request.resource.data.keys().hasAny(['deadline'])
          || request.resource.data.deadline == null
          || request.resource.data.deadline is timestamp)
        && (!request.resource.data.keys().hasAny(['attemptsLimit'])
          || request.resource.data.attemptsLimit == null
          || (request.resource.data.attemptsLimit is int
            && request.resource.data.attemptsLimit >= 1
            && request.resource.data.attemptsLimit <= 50))
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'deadline', 'attemptsLimit', 'status', 'updatedAt'
        ]);

      allow delete: if isStaff()
        && resource.data.orgId == myOrg()
        && (resource.data.teacherId == request.auth.uid || isAdmin());
    }
  }
}
