// ui/pages/teacher-results.js
import { getTeacherResults } from '../../core/assign.js';

export default async function(testId) {
  const div = document.createElement("div");
  div.innerHTML = "<h2>Результаты</h2><button id='export'>Экспорт в CSV</button><table id='res-table'></table>";
  
  const results = await getTeacherResults(testId);
  const table = div.querySelector("#res-table");
  table.innerHTML = "<tr><th>Ученик</th><th>Баллы</th><th>Дата</th></tr>" + 
    results.map(r => `<tr><td>${r.userId}</td><td>${r.score}</td><td>${r.finishedAt.toDate().toLocaleDateString()}</td></tr>`).join("");

  div.querySelector("#export").onclick = () => {
    const csv = "Ученик,Баллы,Дата\n" + results.map(r => `${r.userId},${r.score},${r.finishedAt.toDate().toLocaleDateString()}`).join("\n");
    const blob = new Blob([csv], {type: 'text/csv'});
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `results_${testId}.csv`;
    a.click();
  };
  return div;
}
